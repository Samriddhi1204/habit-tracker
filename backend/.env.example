# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/habit-tracker

# Secret used to sign JWTs (required)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173

# Port the API server listens on
PORT=8000

# Optional: enables the AI features (weekly report, suggestions,
# recovery plan, chat). The app runs fine without it - AI endpoints
# just return a friendly "disabled" message instead of an error.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
